#!/usr/bin/env bash

# Print the `git branch --delete` commands for every local branch already merged
# into ANY of the given branches.  Pipe to `sh` to actually delete.
# -f,--force: match on the branch's upstream instead of the branch itself, to catch
# branches whose PR was squashed or rebased, and delete with `--delete --force`.

usage() {
    echo "Usage: $(basename "$0") [--force] <main-branch>..." >&2
    exit 1
}

force=0
case "$1" in
    -f | --force) force=1; shift ;;
esac

[ $# -eq 0 ] && usage

mains=("$@")

for main in "${mains[@]}"; do
    if ! git rev-parse --quiet --verify "$main" >/dev/null; then
        echo "'$main' does not exist" >&2
        exit 1
    fi
done

is_main() {
    for main in "${mains[@]}"; do
        [ "$1" = "$main" ] && return 0
    done
    return 1
}

merged_into_any() {
    for main in "${mains[@]}"; do
        git merge-base --is-ancestor "$1" "$main" 2>/dev/null && return 0
    done
    return 1
}

git for-each-ref --format='%(refname:short) %(upstream:short)' refs/heads |
    while read -r branch upstream; do
        is_main "$branch" && continue

        if [ $force -eq 1 ]; then
            [ -n "$upstream" ] && merged_into_any "$upstream" &&
                echo "git branch --delete --force $branch"
        else
            merged_into_any "$branch" && echo "git branch --delete $branch"
        fi
    done
